# Supabase Configuration
# Replace with your project values from the Supabase Dashboard: Project Settings > API
# Note: ONLY public/anon keys should be used here. NEVER use the service_role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-publishable-key
